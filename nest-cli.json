{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/read-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/read-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/read-service",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "exec": "OTEL_SERVICE_NAME=auth-service node --env-file=.env --import ./instrumentation.mjs",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "read-service": {
      "type": "application",
      "root": "apps/read-service",
      "entryFile": "main",
      "exec": "OTEL_SERVICE_NAME=read-service node --env-file=.env --import ./instrumentation.mjs",
      "sourceRoot": "apps/read-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/read-service/tsconfig.app.json"
      }
    },
    "validation": {
      "type": "library",
      "root": "libs/validation",
      "entryFile": "index",
      "sourceRoot": "libs/validation/src",
      "compilerOptions": {
        "tsConfigPath": "libs/validation/tsconfig.lib.json"
      }
    },
    "write-service": {
      "type": "application",
      "root": "apps/write-service",
      "entryFile": "main",
      "exec": "OTEL_SERVICE_NAME=write-service node --env-file=.env --import ./instrumentation.mjs",
      "sourceRoot": "apps/write-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/write-service/tsconfig.app.json"
      }
    }
  }
}
