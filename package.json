{
  "name": "cutitshort-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "mprocs",
    "start:short-url-read": "nest start short-url-read-service --watch",
    "start:short-url-write": "nest start short-url-write-service --watch",
    "start:auth": "nest start auth-service --watch",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "prisma generate --config prisma.auth.config.ts && prisma generate --config prisma.short-urls.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.auth.config.ts && prisma migrate deploy --config prisma.short-urls.config.ts",
    "db:reset": "docker compose down -v postgres &&docker compose up -d --wait postgres && pnpm db:migrate"
  },
  "dependencies": {
    "@fastify/otel": "0.21.3",
    "@keyv/redis": "5.1.6",
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs-redis/client": "2.0.1",
    "@nestjs-redis/lock": "2.0.1",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/instrumentation-redis": "0.72.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cache-manager": "7.2.9",
    "keyv": "^5.6.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "^5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.9",
    "@types/bcrypt": "6.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@vitest/coverage-v8": "^4.1.2",
    "mprocs": "0.9.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ],
    "patchedDependencies": {
      "@redis-kit/lock@0.1.0-3": "patches/@redis-kit__lock@0.1.0-3.patch"
    }
  }
}
