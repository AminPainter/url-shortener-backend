generator client {
  provider = "prisma-client"
  output   = "../libs/prisma/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ShortUrl {
  id        BigInt   @id @default(autoincrement())
  shortCode String   @unique
  longUrl   String
  createdAt DateTime @default(now())
  userId    BigInt?

  @@index([userId])
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
