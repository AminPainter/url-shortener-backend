{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/validation": ["./libs/validation/src"]
    },
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/read-service/tsconfig.app.json"
    },
    {
      "path": "./apps/write-service/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
